---
/**
 * Shared layout for Gournadi's editorial / policy pages.
 *
 * Keeps the Bangla long-form pages visually consistent with the storefront
 * without adding them to the CMS: the copy is brand policy, versioned in git.
 */
interface Section {
  heading?: string;
  body: string[];
  list?: string[];
}

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  sections: Section[];
  footerNote?: string;
}

const { title, eyebrow = "গৌরনদী ডিজিটাল", intro, sections, footerNote } = Astro.props;
import Shop from "../layouts/Shop.astro";
---

<Shop title={title} description={intro}>
  <article class="legal">
    <div class="container legal-inner">
      <header class="legal-head">
        <p class="legal-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        {intro && <p class="legal-intro">{intro}</p>}
      </header>

      {sections.map((s) => (
        <section class="legal-section">
          {s.heading && <h2>{s.heading}</h2>}
          {s.body.map((p) => <p>{p}</p>)}
          {s.list && (
            <ul>
              {s.list.map((li) => <li>{li}</li>)}
            </ul>
          )}
        </section>
      ))}

      {footerNote && <p class="legal-note">{footerNote}</p>}

      <div class="legal-actions">
        <a class="btn-primary" href="/shop">সব পণ্য দেখুন</a>
        <a class="btn-ghost" href="/contact">যোগাযোগ করুন</a>
      </div>
    </div>
  </article>
</Shop>

<style>
  .legal {
    padding: 5rem 0 2rem;
  }
  .legal-inner {
    max-width: 46rem;
  }
  .legal-head {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-mid);
  }
  .legal-eyebrow {
    margin: 0 0 1rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-deep);
  }
  .legal-head h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .legal-intro {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-mid);
    margin: 0;
  }
  .legal-section {
    margin-bottom: 2.25rem;
  }
  .legal-section h2 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 0.75rem;
  }
  .legal-section p {
    color: var(--text-mid);
    line-height: 1.85;
  }
  .legal-section ul {
    margin: 0 0 1rem;
    padding-left: 1.15rem;
    color: var(--text-mid);
    line-height: 1.9;
  }
  .legal-section li {
    margin-bottom: 0.25rem;
  }
  .legal-note {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--green);
    background: var(--surface-2);
    color: var(--text-mid);
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .legal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
